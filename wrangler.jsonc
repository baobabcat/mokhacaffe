{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mokhacaffe",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "mokhacaffe.com", "custom_domain": true },
    { "pattern": "www.mokhacaffe.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
